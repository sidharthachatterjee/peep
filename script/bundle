#!/bin/sh
# Builds target/Peep.app from the release build, with its icon compiled by Xcode.
set -eu

root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
xcode="${XCODE:-/Applications/Xcode.app}"
minimum_macos=14.0
cargo build --release --locked

version=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n 1)
app="$root/target/Peep.app"
rm -rf "$app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp target/release/peep "$app/Contents/MacOS/peep"

# The layered icon becomes Assets.car, which current macOS renders in each appearance,
# plus AppIcon.icns for versions before that.
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
DEVELOPER_DIR="$xcode/Contents/Developer" xcrun actool assets/icon/AppIcon.icon \
    --compile "$app/Contents/Resources" --app-icon AppIcon \
    --platform macosx --target-device mac --minimum-deployment-target "$minimum_macos" \
    --output-partial-info-plist "$work/icon.plist" --errors --warnings >/dev/null

cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key><string>Peep</string>
    <key>CFBundleDisplayName</key><string>Peep</string>
    <key>CFBundleIdentifier</key><string>dev.sidhartha.peep</string>
    <key>CFBundleExecutable</key><string>peep</string>
    <key>CFBundleIconFile</key><string>AppIcon</string>
    <key>CFBundleIconName</key><string>AppIcon</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$version</string>
    <key>CFBundleVersion</key><string>$version</string>
    <key>LSMinimumSystemVersion</key><string>$minimum_macos</string>
    <key>LSApplicationCategoryType</key><string>public.app-category.social-networking</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSPrincipalClass</key><string>NSApplication</string>
</dict>
</plist>
PLIST
echo "$app"
